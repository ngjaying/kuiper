### 实时流
PUT http://{{host}}/streams/spiStream
Content-Type: application/json

{
  "sql": "CREATE STREAM spiStream() WITH (TYPE=\"mqtt\",FORMAT=\"spi\",DATASOURCE=\"canudp\",SCHEMAID=\"dbc\/geely\/geely.json\", SHARED=\"true\");"
}

### 实时采集
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "ruleAll",
  "name": "实时采集",
  "sql": "SELECT * FROM spiStream",
  "actions": [
    {
      "mqtt": {
        "server": "tcp://syno.home:1883",
        "topic": "result/all",
        "sendSingle": true
      }
    }
  ]
}

