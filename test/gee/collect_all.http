###### 场景5 轮转帧
### 电压采集规则
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "ruleCellu",
  "name": "电池电压收集",
  "sql": "SELECT collectu(hvBattCellUInfo_UB, hvBattCellUInfoU1, hvBattCellUInfoU2, hvBattCellUInfoU3, hvBattCellUInfoU4) as data FROM celluStream WHERE IsNull(data) = false",
  "actions": [
    {
      "mqtt": {
        "server": "tcp://127.0.0.1:1883",
        "topic": "ek/cell/1/ruleCellu/{{prop \"cs\"}}/{{prop \"nc\"}}/{{prop \"v\"}}/{{prop \"sv\"}}/{{prop \"et\"}}",
        "format": "delimited",
        "fields": ["data"],
        "hasHeader": false,
        "sendSingle": true,
        "compression": "zstd",
        "encryption": "aes",
        "encProps": {
          "mode": "gcm",
          "iv": "mao+aO2Bc6Du0GaE",
          "aad": "TSPDzsM0tJvbNwxDf+x43g==",
          "tagSize": 32
        }
      }
    }
  ]
}

