##### 场景3 诊断规则
###
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "d10001",
  "name": "诊断规则1",
  "sql": "SELECT `ZCU_CANFD1.0x53.VehModMngtGlbSafe1UsgModSts` FROM spiStream WHERE had_changed(true, `ZCU_CANFD1.0x53.VehModMngtGlbSafe1UsgModSts`)",
  "actions": [
    {
      "mqtt": {
        "format": "json",
        "sendSingle": true,
        "server": "tcp://127.0.0.1:1883",
        "topic": "result/dia10001"
      }
    }
  ]
}

