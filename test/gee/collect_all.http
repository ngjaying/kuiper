###
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "d10006",
  "name": "诊断规则6",
  "sql": "SELECT DoorDrvrSts, DoorDrvrSwitch, BtnLockSts FROM spiStream WHERE DoorDrvrSts = 1 AND ((DoorDrvrSwitch = 2 AND (IsRestarted() OR ts - lag(ts) OVER (WHEN DoorDrvrSwitch = 2 AND lag(DoorDrvrSwitch) = 0)) OR (BtnLockSts = 1 AND (IsRestarted() OR ts - lag(ts) OVER (WHEN BtnLockSts = 1 AND lag(BtnLockSts) = 0)))",
  "actions": [
    {
      "mqtt": {
        "format": "json",
        "sendSingle": true,
        "server": "tcp://127.0.0.1:1883",
        "topic": "result/dia10006"
      }
    }
  ]
}


