        "format": "delimited",
        "hasHeader": true,
        "sendSingle": false,
        "batchSize": 10000,
        "compression": "zstd",
        "encryption": "aes",
        "encProps": {
          "mode": "gcm",
          "iv": "mao+aO2Bc6Du0GaE",
          "aad": "TSPDzsM0tJvbNwxDf+x43g==",
          "tagSize": 32
        }
      }
