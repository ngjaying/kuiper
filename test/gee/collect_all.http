##### 场景3 诊断规则

###
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "d10002",
  "name": "诊断规则2",
  "sql": "SELECT `ZCU_CANFD1.0x53.VehModMngtGlbSafe1CarModSts1` FROM spiStream WHERE had_changed(true, `ZCU_CANFD1.0x53.VehModMngtGlbSafe1CarModSts1`)",
  "actions": [
    {
      "mqtt": {
        "format": "json",
        "sendSingle": true,
        "server": "tcp://127.0.0.1:1883",
        "topic": "result/dia10002"
      }
    }
  ]
}

###
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "d10003",
  "name": "诊断规则3",
  "sql": "SELECT `ZCU_CANFD2.0x43.CrashSts2`, `PropulsionCAN.0x35.CrashStsSafeSts` FROM spiStream WHERE (`ZCU_CANFD2.0x43.CrashSts2` = 2 AND lag(`ZCU_CANFD2.0x43.CrashSts2`, 1, 0, true) != 2) OR (`PropulsionCAN.0x35.CrashStsSafeSts` = 1 AND lag(`PropulsionCAN.0x35.CrashStsSafeSts`, 1, 0, true) != 1)",
  "actions": [
    {
      "mqtt": {
        "format": "json",
        "sendSingle": true,
        "server": "tcp://127.0.0.1:1883",
        "topic": "result/dia10003"
      }
    }
  ]
}

