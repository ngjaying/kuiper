  }
}

###
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "rulePick3",
  "name": "事件采集例子",
  "sql": "SELECT ts, `PropulsionCAN.0x342.HvPackOverChrgFlt`,`PropulsionCAN.0x315.HvBattTAvg`,`PropulsionCAN.0x346.HvBattCooltLvl`,`PropulsionCAN.0x342.HvBattMismatchFlt`,`PropulsionCAN.0x342.HvCellTOverFlt`,`PropulsionCAN.0x342.HvilFlt`,`PropulsionCAN.0x145.CellUMaxId`,`PropulsionCAN.0x145.CellUMin`,`PropulsionCAN.0x145.CellUMinId`,`PropulsionCAN.0x142.HvBattCellUInfoU4`,`PropulsionCAN.0x315.HvBattTMax`,`PropulsionCAN.0x342.HvCellUOverFlt`,`PropulsionCAN.0x342.HvSocHiFlt`,`PropulsionCAN.0x288.FastChrgnLEDIndctn`,`PropulsionCAN.0x178.HvBattCoolgReq`,`PropulsionCAN.0x342.HvPackUOverFlt`,`PropulsionCAN.0x342.HvPackUUnderFlt`,`PropulsionCAN.0x315.HvBattTMin`,`ZCU_CANFD1.0x353.DCChrgnHndlSts`,`PropulsionCAN.0x342.HvCellTDifFlt`,`PropulsionCAN.0x342.HvCellUUnderFlt`,`PropulsionCAN.0x342.HvSocLoFlt`,`PropulsionCAN.0x142.HvBattCellUInfoU3`,`PropulsionCAN.0x295.HvBattCoolgSts`,`PropulsionCAN.0x342.HvCellUDifFlt`,`PropulsionCAN.0x342.HvSocHopFlt` FROM spiStream GROUP BY SlidingWindow(ss, 30) OVER (WHEN ((`PropulsionCAN.0x342.HvBattMismatchFlt` != 0 AND lag(`PropulsionCAN.0x342.HvBattMismatchFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellTDifFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellTDifFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellTOverFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellTOverFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellUDifFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellUDifFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellUOverFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellUOverFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellUUnderFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellUUnderFlt`) = 0) OR (`PropulsionCAN.0x342.HvPackOverChrgFlt` != 0 AND lag(`PropulsionCAN.0x342.HvPackOverChrgFlt`) = 0) OR (`PropulsionCAN.0x342.HvPackUOverFlt` != 0 AND lag(`PropulsionCAN.0x342.HvPackUOverFlt`) = 0) OR (`PropulsionCAN.0x342.HvPackUUnderFlt` != 0 AND lag(`PropulsionCAN.0x342.HvPackUUnderFlt`) = 0) OR (`PropulsionCAN.0x342.HvSocHiFlt` != 0 AND lag(`PropulsionCAN.0x342.HvSocHiFlt`) = 0) OR (`PropulsionCAN.0x342.HvSocHopFlt` != 0 AND lag(`PropulsionCAN.0x342.HvSocHopFlt`) = 0) OR (`PropulsionCAN.0x342.HvSocLoFlt` != 0 AND lag(`PropulsionCAN.0x342.HvSocLoFlt`) = 0) OR (`PropulsionCAN.0x342.HvilFlt` != 0 AND lag(`PropulsionCAN.0x342.HvilFlt`) = 0)) AND ts - last_hit_time() > 40000)",
  "actions": [
    {
      "mqtt": {
        "topic": "ek/event/3/rulePick3/{{prop \"cs\"}}/{{prop \"nc\"}}/{{prop \"v\"}}/{{prop \"sv\"}}/{{prop \"et\"}}",
        "sendSingle": false,
        "server": "tcp://127.0.0.1:1883",
        "format": "delimited",
        "hasHeader": true,
        "compression": "zstd",
        "encryption": "aes",
        "encProps": {
          "mode": "gcm",
          "iv": "mao+aO2Bc6Du0GaE",
          "aad": "TSPDzsM0tJvbNwxDf+x43g==",
          "tagSize": 32
        }
      }
    }
  ],
  "options": {
    "sendError": false,
    "sendNilField": true
  }
}

