POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "rulePick2",
  "name": "事件采集例子",
  "sql": "SELECT rule_id(), last_value(ts, true) as event_time, collect(object_construct(\"ts\", ts, \"PropulsionCAN.0x15E.BECMHvUMainPosRlyU\",`PropulsionCAN.0x53.CPSRU`,\"PropulsionCAN.0x157.BECMHvPosRlyCirtCurr\",`PropulsionCAN.0x157.BECMHvPosRlyCirtCurr`,\"PropulsionCAN.0x178.HvSysLimnIndcn\",`PropulsionCAN.0x178.HvSysLimnIndcn`,\"PropulsionCAN.0x156.IsgUDc\",`PropulsionCAN.0x156.IsgUDc`,\"PropulsionCAN.0x15E.BECMHvUHvFuseU\",`PropulsionCAN.0x15E.BECMHvUHvFuseU`,\"PropulsionCAN.0x197.BECMSupplyVoltKL30\",`PropulsionCAN.0x197.BECMSupplyVoltKL30`,\"PropulsionCAN.0x141.HvBattUDc\",`PropulsionCAN.0x141.HvBattUDc`,\"PropulsionCAN.0x143.HvBattIDc1\",`PropulsionCAN.0x143.HvBattIDc1`,\"PropulsionCAN.0x15E.BECMHvUMainNegRlyU\",`PropulsionCAN.0x15E.BECMHvUMainNegRlyU`)) as data FROM spiStream GROUP BY SlidingWindow(ss, 30) OVER (WHEN `PropulsionCAN.0x178.HvSysLimnIndcn` IN (95,100,1263,1432) AND lag(`PropulsionCAN.0x178.HvSysLimnIndcn`) NOT IN (95,100,1263,1432))",
  "actions": [
    {
      "mqtt": {
        "topic": "result/pick2/{{.rule_id}}/{{.event_time}}",
        "dataField": "data",
        "sendSingle": true,
        "server": "tcp://127.0.0.1:1883",
        "format": "delimited",
        "hasHeader": true,
        "compression": "zstd"
      }
    }
  ],
  "options": {
    "sendError": false
  }
}

###
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "rulePick3",
  "name": "事件采集例子",
  "sql": "SELECT rule_id(), last_value(ts, true) as event_time, collect(\"ts\", ts, `PropulsionCAN.0x342.HvPackOverChrgFlt`,\"PropulsionCAN.0x342.HvPackOverChrgFlt\",`PropulsionCAN.0x315.HvBattTAvg`,\"PropulsionCAN.0x315.HvBattTAvg\",`PropulsionCAN.0x346.HvBattCooltLvl`,\"PropulsionCAN.0x346.HvBattCooltLvl\",`PropulsionCAN.0x342.HvBattMismatchFlt`,\"PropulsionCAN.0x342.HvBattMismatchFlt\",`PropulsionCAN.0x342.HvCellTOverFlt`,\"PropulsionCAN.0x342.HvCellTOverFlt\",`PropulsionCAN.0x342.HvilFlt`,\"PropulsionCAN.0x342.HvilFlt\",`PropulsionCAN.0x145.CellUMaxId`,\"PropulsionCAN.0x145.CellUMaxId\",`PropulsionCAN.0x145.CellUMin`,\"PropulsionCAN.0x145.CellUMin\",`PropulsionCAN.0x145.CellUMinId`,\"PropulsionCAN.0x145.CellUMinId\",`PropulsionCAN.0x142.HvBattCellUInfoU4`,\"PropulsionCAN.0x142.HvBattCellUInfoU4\",`PropulsionCAN.0x315.HvBattTMax`,\"PropulsionCAN.0x315.HvBattTMax\",`PropulsionCAN.0x342.HvCellUOverFlt`,\"PropulsionCAN.0x342.HvCellUOverFlt\",`PropulsionCAN.0x342.HvSocHiFlt`,\"PropulsionCAN.0x342.HvSocHiFlt\",`PropulsionCAN.0x288.FastChrgnLEDIndctn`,\"PropulsionCAN.0x288.FastChrgnLEDIndctn\",`PropulsionCAN.0x178.HvBattCoolgReq`,\"PropulsionCAN.0x178.HvBattCoolgReq\",`PropulsionCAN.0x342.HvPackUOverFlt`,\"PropulsionCAN.0x342.HvPackUOverFlt\",`PropulsionCAN.0x342.HvPackUUnderFlt`,\"PropulsionCAN.0x342.HvPackUUnderFlt\",`PropulsionCAN.0x315.HvBattTMin`,\"PropulsionCAN.0x315.HvBattTMin\",`ZCU_CANFD1.0x353.DCChrgnHndlSts`,\"ZCU_CANFD1.0x353.DCChrgnHndlSts\",`PropulsionCAN.0x342.HvCellTDifFlt`,\"PropulsionCAN.0x342.HvCellTDifFlt\",`PropulsionCAN.0x342.HvCellUUnderFlt`,\"PropulsionCAN.0x342.HvCellUUnderFlt\",`PropulsionCAN.0x342.HvSocLoFlt`,\"PropulsionCAN.0x342.HvSocLoFlt\",`PropulsionCAN.0x142.HvBattCellUInfoU3`,\"PropulsionCAN.0x142.HvBattCellUInfoU3\",`PropulsionCAN.0x295.HvBattCoolgSts`,\"PropulsionCAN.0x295.HvBattCoolgSts\",`PropulsionCAN.0x342.HvCellUDifFlt`,\"PropulsionCAN.0x342.HvCellUDifFlt\",`PropulsionCAN.0x342.HvSocHopFlt`,\"PropulsionCAN.0x342.HvSocHopFlt\") as data FROM spiStream GROUP BY SlidingWindow(ss, 30) OVER (WHEN (`PropulsionCAN.0x342.HvBattMismatchFlt` != 0 AND lag(`PropulsionCAN.0x342.HvBattMismatchFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellTDifFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellTDifFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellTOverFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellTOverFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellUDifFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellUDifFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellUOverFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellUOverFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellUUnderFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellUUnderFlt`) = 0) OR (`PropulsionCAN.0x342.HvPackOverChrgFlt` != 0 AND lag(`PropulsionCAN.0x342.HvPackOverChrgFlt`) = 0) OR (`PropulsionCAN.0x342.HvPackUOverFlt` != 0 AND lag(`PropulsionCAN.0x342.HvPackUOverFlt`) = 0) OR (`PropulsionCAN.0x342.HvPackUUnderFlt` != 0 AND lag(`PropulsionCAN.0x342.HvPackUUnderFlt`) = 0) OR (`PropulsionCAN.0x342.HvSocHiFlt` != 0 AND lag(`PropulsionCAN.0x342.HvSocHiFlt`) = 0) OR (`PropulsionCAN.0x342.HvSocHopFlt` != 0 AND lag(`PropulsionCAN.0x342.HvSocHopFlt`) = 0) OR (`PropulsionCAN.0x342.HvSocLoFlt` != 0 AND lag(`PropulsionCAN.0x342.HvSocLoFlt`) = 0) OR (`PropulsionCAN.0x342.HvilFlt` != 0 AND lag(`PropulsionCAN.0x342.HvilFlt`) = 0))",
  "actions": [
    {
      "mqtt": {
        "topic": "result/pick3/{{.rule_id}}/{{.event_time}}",
        "dataField": "data",
        "sendSingle": true,
        "server": "tcp://127.0.0.1:1883",
        "format": "delimited",
        "hasHeader": true,
        "compression": "zstd"
      }
    }
  ],
  "options": {
    "sendError": false
  }
}

