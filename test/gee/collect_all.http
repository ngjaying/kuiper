Content-Type: application/json

{
  "sql": "CREATE TABLE nanoTable() WITH (TYPE=\"nano\",FORMAT=\"spi\",SCHEMAID=\"data\/uploads\/dbc\",KIND=\"lookup\",CONF_KEY=\"lookup\");"
}

### send with start and end
POST http://{{host}}/streams
Content-Type: application/json

{
  "sql": "CREATE STREAM triggerStream() WITH (TYPE=\"mqtt\",FORMAT=\"json\",DATASOURCE=\"trigger\",SHARED=\"true\");"
}

