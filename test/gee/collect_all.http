#### 已通过 init.json 生成初始流和规则
#### 需要提前创建 /bigdata

### init 创建的流和规则
### 实时流
PUT http://{{host}}/streams/spiStream
Content-Type: application/json

{
  "sql": "CREATE STREAM spiStream() WITH (TYPE=\"mqtt\",FORMAT=\"spi\",DATASOURCE=\"canudp\",SCHEMAID=\"data\/uploads\/dbc\", SHARED=\"true\")"
}

### 1s降采样流
POST http://{{host}}/streams
Content-Type: application/json

{
  "sql": "CREATE STREAM spi_1000ms_stream () WITH (TYPE=\"mqtt\", FORMAT=\"spi\", DATASOURCE=\"canudp\", SCHEMAID=\"data\/uploads\/dbc\", SHARED=\"TRUE\", CONF_KEY=\"spi_1000ms\")"
}

### 1s降采样流
POST http://{{host}}/streams
Content-Type: application/json

{
  "sql": "CREATE STREAM spi_200ms_stream () WITH (TYPE=\"mqtt\", FORMAT=\"spi\", DATASOURCE=\"canudp\", SCHEMAID=\"data\/uploads\/dbc\", SHARED=\"TRUE\", CONF_KEY=\"spi_200ms\")"
}

### 创建长期运行的唯一触发流，用于接收云端的查询请求
### send with start and end
POST http://{{host}}/streams
Content-Type: application/json

{
  "sql": "CREATE STREAM triggerStream() WITH (TYPE=\"mqtt\",FORMAT=\"json\",DATASOURCE=\"trigger\",SHARED=\"true\");"
}

### 创建长期运行采集流定义，接入nano query 异步结果
POST http://{{host}}/streams
Content-Type: application/json

{
  "sql": "CREATE STREAM queryStream () WITH (TYPE=\"nanoquery\", FORMAT=\"spi\", SCHEMAID=\"data\/uploads\/dbc\", SHARED=\"TRUE\")"
}

### trigger rule
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "ruleTrigger",
  "name": "发送查询请求",
  "sql": "SELECT \"async\" as kind, ts1, ts2 FROM triggerStream",
  "actions": [
    {
      "nanoquery": {
        "url": "tcp://127.0.0.1:10000",
        "format": "delimited",
        "delimiter": "-",
        "fields": [
          "kind",
          "ts1",
          "ts2"
        ],
        "sendSingle": true
      }
    }
  ]
}

### 场景一周期采集 10s 文件采集 For Local (去除rollingNamePattern，若是在盒子测试，防止硬盘满)
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "rule10secondCSV_ZSTD",
  "name": "10s周期文件压缩",
  "sql": "SELECT * FROM spi_1000ms_stream",
  "actions": [
    {
      "file": {
        "path": "/bigdata/rule1/mock.zstd",
        "format": "delimited",
        "fileType": "csv",
        "hasHeader": true,
        "sendSingle": true,
        "rollingInterval": "10s",
        "compression": "zstd",
        "rollingNamePattern": "suffix",
        "rollingHook": "nano",
        "rollingHookProps": {
          "server": "tcp://127.0.0.1:1883",
          "topic": "file_transfer",
          "delete": 10
        }
      }
    }
  ],
  "options": {
    "sendError": false
  }
}

##### 场景2 事件采集
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "rulePick1",
  "name": "事件采集例子",
  "sql": "SELECT rule_id(), last_value(ts, true) as event_time, collect(object_construct(\"ts\", ts,`ZCU_CANFD1.0x180.BrkPedlPsdBrkPedlPsd`,\"ZCU_CANFD1.0x180.BrkPedlPsdBrkPedlPsd\",`ConnectivityCANFD.0x3C8.VehSpdAvgIndcdVehSpdIndcd`,\"ConnectivityCANFD.0x3C8.VehSpdAvgIndcdVehSpdIndcd\",`PropulsionCAN.0x142.HvBattCellUInfoU3`,\"PropulsionCAN.0x142.HvBattCellUInfoU3\",`PropulsionCAN.0x142.HvBattCellUInfoU4`,\"PropulsionCAN.0x142.HvBattCellUInfoU4\",`PropulsionCAN.0x315.HvBattTMin`,\"PropulsionCAN.0x315.HvBattTMin\",`ZCU_CANFD2.0x491.BattIRaw`,\"ZCU_CANFD2.0x491.BattIRaw\",`ZCU_CANFD2.0x138.BattURaw`,\"ZCU_CANFD2.0x138.BattURaw\",`PropulsionCAN.0x142.HvBattLimnIndcn`,\"PropulsionCAN.0x142.HvBattLimnIndcn\",`PropulsionCAN.0x145.CellUMax`,\"PropulsionCAN.0x145.CellUMax\",`PropulsionCAN.0x145.CellUMaxId`,\"PropulsionCAN.0x145.CellUMaxId\",`PropulsionCAN.0x145.CellUMinId`,\"PropulsionCAN.0x145.CellUMinId\",`PropulsionCAN.0x315.HvBattTAvg`,\"PropulsionCAN.0x315.HvBattTAvg\",`PropulsionCAN.0x331.HvBattCooltT`,\"PropulsionCAN.0x331.HvBattCooltT\",`PropulsionCAN.0x178.HvSysLimnIndcn`,\"PropulsionCAN.0x178.HvSysLimnIndcn\",`PropulsionCAN.0x145.CellUMin`,\"PropulsionCAN.0x145.CellUMin\",`PropulsionCAN.0x315.HvBattTMax`,\"PropulsionCAN.0x315.HvBattTMax\",`PropulsionCAN.0x116.AccrPedlPsdAccrPedlPsd`,\"PropulsionCAN.0x116.AccrPedlPsdAccrPedlPsd\")) as data FROM spiStream GROUP BY SlidingWindow(ss, 30) OVER (WHEN `PropulsionCAN.0x142.HvBattLimnIndcn` = 1 AND lag(`PropulsionCAN.0x142.HvBattLimnIndcn`) != 1)",
  "actions": [
    {
      "mqtt": {
        "topic": "result/pick1/{{.rule_id}}/{{.event_time}}",
        "dataField": "data",
        "sendSingle": true,
        "server": "tcp://127.0.0.1:1883",
        "format": "delimited",
        "hasHeader": true,
        "compression": "zstd"
      }
    }
  ],
  "options": {
    "sendError": false
  }
}

