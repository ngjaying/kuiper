  "sql": "SELECT ts, `ZCU_CANFD2.0x482.IsgActvDampgModReq`,`ZCU_CANFD2.0x1A6.IsgCoolgReqInvrCloud`,`ZCU_CANFD2.0x1A6.IsgCooltFlowMinReqCloud`,`PropulsionCAN.0x13A.IsgCooltT`,`ZCU_CANFD2.0x35.IsgIDc`,`ZCU_CANFD2.0x1A0.BattVoltKL30`,`PropulsionCAN.0x191.FrntHeatModEnad`,`PropulsionCAN.0x141.HvBattUDc`,`PropulsionCAN.0x143.HvBattIDc1`,`ZCU_CANFD2.0x138.IsgInvrT`,`ZCU_CANFD2.0x489.IsgLimnIndcn`,`PropulsionCAN.0x287.CooltFlowForDtElec`,`ZCU_CANFD2.0x1A0.FrntHeatPwrAllwd` FROM spiStream GROUP BY SlidingWindow(ss, 30) OVER (WHEN `ZCU_CANFD2.0x489.IsgLimnIndcn` != 0 AND lag(`ZCU_CANFD2.0x489.IsgLimnIndcn`) = 0)",
