##### 场景1 周期采集
### 1s降采样流
POST http://{{host}}/streams
Content-Type: application/json

{
  "sql": "CREATE STREAM spi_1000ms_stream() WITH (TYPE=\"mqtt\",FORMAT=\"spi\",DATASOURCE=\"canudp\",SCHEMAID=\"dbc\/gee\/gee.json\", SHARED=\"true\", CONF_KEY=\"spi_1000ms\");"
}

### 场景一周期采集 10s 文件采集 For Local (去除rollingNamePattern，若是在盒子测试，防止硬盘满)
PUT http://{{host}}/rules/rule10secondCSV_ZSTD
Content-Type: application/json

{
  "id": "rule10secondCSV_ZSTD",
  "name": "10s周期文件压缩",
  "sql": "SELECT * FROM spi_1000ms_stream",
  "actions": [
    {
      "file": {
        "path": "data/mock.zstd",
        "format": "delimited",
        "fileType": "csv",
        "hasHeader": true,
        "sendSingle": true,
        "rollingInterval": "10s",
        "compression": "zstd",
        "rollingNamePattern": "suffix",
        "rollingHook": "nano",
        "rollingHookProps": {
          "server": "tcp://127.0.0.1:1883",
          "topic": "file_transfer",
          "ruleType": "periodic",
          "delete": 10
        }
      }
    }
  ],
  "options": {
    "sendError": false
  }
}

##### 场景2 事件采集

### 实时流
POST http://{{host}}/streams
Content-Type: application/json

{
  "sql": "CREATE STREAM spiStream() WITH (TYPE=\"mqtt\",FORMAT=\"spi\",DATASOURCE=\"canudp\",SCHEMAID=\"dbc\/gee\/gee.json\", SHARED=\"true\");"
}

### 为保证触发率，添加间隔200s触发的语句
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "rulePick1",
  "name": "事件采集例子",
  "sql": "SELECT ts, `ZCU_CANFD1.0x180.BrkPedlPsdBrkPedlPsd`,`ConnectivityCANFD.0x3C8.VehSpdAvgIndcdVehSpdIndcd`,`PropulsionCAN.0x142.HvBattCellUInfoU3`,`PropulsionCAN.0x142.HvBattCellUInfoU4`,`PropulsionCAN.0x315.HvBattTMin`,`ZCU_CANFD2.0x491.BattIRaw`,`ZCU_CANFD2.0x138.BattURaw`,`PropulsionCAN.0x142.HvBattLimnIndcn`,`PropulsionCAN.0x145.CellUMax`,`PropulsionCAN.0x145.CellUMaxId`,`PropulsionCAN.0x145.CellUMinId`,`PropulsionCAN.0x315.HvBattTAvg`,`PropulsionCAN.0x331.HvBattCooltT`,`PropulsionCAN.0x178.HvSysLimnIndcn`,`PropulsionCAN.0x145.CellUMin`,`PropulsionCAN.0x315.HvBattTMax`,`PropulsionCAN.0x116.AccrPedlPsdAccrPedlPsd` FROM spiStream GROUP BY SlidingWindow(ss, 30) OVER (WHEN `PropulsionCAN.0x142.HvBattLimnIndcn` = 1 AND lag(`PropulsionCAN.0x142.HvBattLimnIndcn`) != 1)",
  "actions": [
    {
      "mqtt": {
        "server": "tcp://127.0.0.1:1883",
        "topic": "result/pick1",
        "compression": "zstd",
        "format": "delimited",
        "hasHeader": true,
        "sendSingle": false
      }
    }
  ],
  "options": {
    "sendError": false
  }
}

### 为保证触发率，添加间隔200s触发的语句
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "rulePick2",
  "name": "事件采集例子",
  "sql": "SELECT props(\"vin\") as vin, props(\"sig_def_ver\") as sdv,last_value(ts, true) as event_time, collect(object_construct(\"ts\", ts, \"PropulsionCAN.0x15E.BECMHvUMainPosRlyU\",`PropulsionCAN.0x53.CPSRU`,\"PropulsionCAN.0x157.BECMHvPosRlyCirtCurr\",`PropulsionCAN.0x157.BECMHvPosRlyCirtCurr`,\"PropulsionCAN.0x178.HvSysLimnIndcn\",`PropulsionCAN.0x178.HvSysLimnIndcn`,\"PropulsionCAN.0x156.IsgUDc\",`PropulsionCAN.0x156.IsgUDc`,\"PropulsionCAN.0x15E.BECMHvUHvFuseU\",`PropulsionCAN.0x15E.BECMHvUHvFuseU`,\"PropulsionCAN.0x197.BECMSupplyVoltKL30\",`PropulsionCAN.0x197.BECMSupplyVoltKL30`,\"PropulsionCAN.0x141.HvBattUDc\",`PropulsionCAN.0x141.HvBattUDc`,\"PropulsionCAN.0x143.HvBattIDc1\",`PropulsionCAN.0x143.HvBattIDc1`,\"PropulsionCAN.0x15E.BECMHvUMainNegRlyU\",`PropulsionCAN.0x15E.BECMHvUMainNegRlyU`)) as data FROM spiStream GROUP BY SlidingWindow(ss, 30) OVER (WHEN (`PropulsionCAN.0x178.HvSysLimnIndcn` IN (95,100,1263,1432) AND lag(`PropulsionCAN.0x178.HvSysLimnIndcn`) NOT IN (95,100,1263,1432)) OR ts - last_hit_time() > 40000)",
  "actions": [
    {
      "mqtt": {
        "topic": "result/event/{{.vin}}/{{.sdv}}/rulePick2/{{.event_time}}",
        "dataField": "data",
        "sendSingle": true,
        "server": "tcp://127.0.0.1:1883",
        "format": "delimited",
        "hasHeader": true,
        "compression": "zstd",
        "encryption": "aes"
      }
    }
  ],
  "options": {
    "sendError": false
  }
}

###
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "rulePick3",
  "name": "事件采集例子",
  "sql": "SELECT ts, `PropulsionCAN.0x342.HvPackOverChrgFlt`,`PropulsionCAN.0x315.HvBattTAvg`,`PropulsionCAN.0x346.HvBattCooltLvl`,`PropulsionCAN.0x342.HvBattMismatchFlt`,`PropulsionCAN.0x342.HvCellTOverFlt`,`PropulsionCAN.0x342.HvilFlt`,`PropulsionCAN.0x145.CellUMaxId`,`PropulsionCAN.0x145.CellUMin`,`PropulsionCAN.0x145.CellUMinId`,`PropulsionCAN.0x142.HvBattCellUInfoU4`,`PropulsionCAN.0x315.HvBattTMax`,`PropulsionCAN.0x342.HvCellUOverFlt`,`PropulsionCAN.0x342.HvSocHiFlt`,`PropulsionCAN.0x288.FastChrgnLEDIndctn`,`PropulsionCAN.0x178.HvBattCoolgReq`,`PropulsionCAN.0x342.HvPackUOverFlt`,`PropulsionCAN.0x342.HvPackUUnderFlt`,`PropulsionCAN.0x315.HvBattTMin`,`ZCU_CANFD1.0x353.DCChrgnHndlSts`,`PropulsionCAN.0x342.HvCellTDifFlt`,`PropulsionCAN.0x342.HvCellUUnderFlt`,`PropulsionCAN.0x342.HvSocLoFlt`,`PropulsionCAN.0x142.HvBattCellUInfoU3`,`PropulsionCAN.0x295.HvBattCoolgSts`,`PropulsionCAN.0x342.HvCellUDifFlt`,`PropulsionCAN.0x342.HvSocHopFlt` FROM spiStream GROUP BY SlidingWindow(ss, 30) OVER (WHEN (`PropulsionCAN.0x342.HvBattMismatchFlt` != 0 AND lag(`PropulsionCAN.0x342.HvBattMismatchFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellTDifFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellTDifFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellTOverFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellTOverFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellUDifFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellUDifFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellUOverFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellUOverFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellUUnderFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellUUnderFlt`) = 0) OR (`PropulsionCAN.0x342.HvPackOverChrgFlt` != 0 AND lag(`PropulsionCAN.0x342.HvPackOverChrgFlt`) = 0) OR (`PropulsionCAN.0x342.HvPackUOverFlt` != 0 AND lag(`PropulsionCAN.0x342.HvPackUOverFlt`) = 0) OR (`PropulsionCAN.0x342.HvPackUUnderFlt` != 0 AND lag(`PropulsionCAN.0x342.HvPackUUnderFlt`) = 0) OR (`PropulsionCAN.0x342.HvSocHiFlt` != 0 AND lag(`PropulsionCAN.0x342.HvSocHiFlt`) = 0) OR (`PropulsionCAN.0x342.HvSocHopFlt` != 0 AND lag(`PropulsionCAN.0x342.HvSocHopFlt`) = 0) OR (`PropulsionCAN.0x342.HvSocLoFlt` != 0 AND lag(`PropulsionCAN.0x342.HvSocLoFlt`) = 0) OR (`PropulsionCAN.0x342.HvilFlt` != 0 AND lag(`PropulsionCAN.0x342.HvilFlt`) = 0))",
  "actions": [
    {
      "mqtt": {
        "server": "tcp://syno.home:1883",
        "topic": "result/pick3",
        "compression": "zstd",
        "format": "delimited",
        "hasHeader": true,
        "sendSingle": false
      }
    }
  ],
  "options": {
    "sendError": false
  }
}

###
PUT http://{{host}}/rules/rulePick3
Content-Type: application/json

{
  "id": "rulePick3",
  "name": "事件采集例子",
  "sql": "SELECT ts, `PropulsionCAN.0x342.HvPackOverChrgFlt`,`PropulsionCAN.0x315.HvBattTAvg`,`PropulsionCAN.0x346.HvBattCooltLvl`,`PropulsionCAN.0x342.HvBattMismatchFlt`,`PropulsionCAN.0x342.HvCellTOverFlt`,`PropulsionCAN.0x342.HvilFlt`,`PropulsionCAN.0x145.CellUMaxId`,`PropulsionCAN.0x145.CellUMin`,`PropulsionCAN.0x145.CellUMinId`,`PropulsionCAN.0x142.HvBattCellUInfoU4`,`PropulsionCAN.0x315.HvBattTMax`,`PropulsionCAN.0x342.HvCellUOverFlt`,`PropulsionCAN.0x342.HvSocHiFlt`,`PropulsionCAN.0x288.FastChrgnLEDIndctn`,`PropulsionCAN.0x178.HvBattCoolgReq`,`PropulsionCAN.0x342.HvPackUOverFlt`,`PropulsionCAN.0x342.HvPackUUnderFlt`,`PropulsionCAN.0x315.HvBattTMin`,`ZCU_CANFD1.0x353.DCChrgnHndlSts`,`PropulsionCAN.0x342.HvCellTDifFlt`,`PropulsionCAN.0x342.HvCellUUnderFlt`,`PropulsionCAN.0x342.HvSocLoFlt`,`PropulsionCAN.0x142.HvBattCellUInfoU3`,`PropulsionCAN.0x295.HvBattCoolgSts`,`PropulsionCAN.0x342.HvCellUDifFlt`,`PropulsionCAN.0x342.HvSocHopFlt` FROM spiStream GROUP BY SlidingWindow(ss, 30) OVER (WHEN ((`PropulsionCAN.0x342.HvBattMismatchFlt` != 0 AND lag(`PropulsionCAN.0x342.HvBattMismatchFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellTDifFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellTDifFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellTOverFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellTOverFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellUDifFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellUDifFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellUOverFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellUOverFlt`) = 0) OR (`PropulsionCAN.0x342.HvCellUUnderFlt` != 0 AND lag(`PropulsionCAN.0x342.HvCellUUnderFlt`) = 0) OR (`PropulsionCAN.0x342.HvPackOverChrgFlt` != 0 AND lag(`PropulsionCAN.0x342.HvPackOverChrgFlt`) = 0) OR (`PropulsionCAN.0x342.HvPackUOverFlt` != 0 AND lag(`PropulsionCAN.0x342.HvPackUOverFlt`) = 0) OR (`PropulsionCAN.0x342.HvPackUUnderFlt` != 0 AND lag(`PropulsionCAN.0x342.HvPackUUnderFlt`) = 0) OR (`PropulsionCAN.0x342.HvSocHiFlt` != 0 AND lag(`PropulsionCAN.0x342.HvSocHiFlt`) = 0) OR (`PropulsionCAN.0x342.HvSocHopFlt` != 0 AND lag(`PropulsionCAN.0x342.HvSocHopFlt`) = 0) OR (`PropulsionCAN.0x342.HvSocLoFlt` != 0 AND lag(`PropulsionCAN.0x342.HvSocLoFlt`) = 0) OR (`PropulsionCAN.0x342.HvilFlt` != 0 AND lag(`PropulsionCAN.0x342.HvilFlt`) = 0)) AND ts - last_hit_time() > 40000)",
  "actions": [
    {
      "mqtt": {
        "server": "tcp://syno.home:1883",
        "topic": "result/pick3",
        "compression": "zstd",
        "format": "delimited",
        "hasHeader": true,
        "sendSingle": false
      }
    }
  ],
  "options": {
    "sendError": false
  }
}

