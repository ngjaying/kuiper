##### 故障灯规则
### 故障灯信号流
POST http://{{host}}/streams
Content-Type: application/json

{
  "sql": "CREATE STREAM sigStream() WITH (TYPE=\"mqtt\",FORMAT=\"sigl\",DATASOURCE=\"signal\", SHARED=\"true\");"
}

### 信号灯诊断规则
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "ruleSig",
  "name": "测试信号灯诊断",
  "sql": "SELECT ts, notifyLed(PA_VehNotifAndLedFlt) as n FROM sigStream WHERE cardinality(n) > 0",
  "actions": [
    {
      "mqtt": {
        "server": "tcp://syno.home:1883",
        "topic": "result/sig",
        "sendSingle": true
      }
    }
  ]
}

##### 电池电压规则
### 电池电压流
POST http://{{host}}/streams
Content-Type: application/json

{
  "sql": "CREATE STREAM celluStream() WITH (TYPE=\"mqtt\",FORMAT=\"cellu\",DATASOURCE=\"batt/cell\", SHARED=\"true\");"
}

### 电流诊断规则
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "ruleCellu",
  "name": "电池电压收集",
  "sql": "SELECT event_time() as ts, collectu(hvBattCellUInfo_UB, hvBattCellUInfoU1, hvBattCellUInfoU2, hvBattCellUInfoU3, hvBattCellUInfoU4) as data FROM celluStream WHERE IsNull(data) = false",
  "actions": [
    {
      "mqtt": {
        "server": "tcp://syno.home:1883",
        "topic": "result/{{.ts}}/ruleCellu",
        "format": "delimited",
        "fields": ["data"],
        "hasHeader": false,
        "compression": "zstd",
        "encryption": "aes",
        "sendSingle": true
      }
    }
  ]
}

### 电流诊断规则
POST http://{{host}}/rules/ruleCellu/restart

### 电池温度流
POST http://{{host}}/streams
Content-Type: application/json

{
  "sql": "CREATE STREAM celltStream() WITH (TYPE=\"mqtt\",FORMAT=\"cellt\",DATASOURCE=\"batt/tsnsr\", SHARED=\"true\");"
}

### 电流诊断规则
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "ruleCellt",
  "name": "电池电压收集",
  "sql": "SELECT event_time() as ts, collectt(HvBattCellTInfoHvBattTSnsrNr, HvBattCellTInfoHvBattSnsrT) as data FROM celltStream WHERE IsNull(data) = false",
  "actions": [
    {
      "mqtt": {
        "server": "tcp://syno.home:1883",
        "topic": "result/{{.ts}}/ruleCellt",
        "format": "delimited",
        "fields": ["data"],
        "hasHeader": false,
        "sendSingle": true
      }
    }
  ]
}

###
GET http://{{host}}/rules/ruleCellu/status

##### 场景3 历史采集-Aysnc
### 1. 创建长期运行的唯一触发流，用于接收云端的查询请求
### send with start and end
POST http://{{host}}/streams
Content-Type: application/json

{
  "sql": "CREATE STREAM triggerStream() WITH (TYPE=\"mqtt\",FORMAT=\"json\",DATASOURCE=\"trigger\",SHARED=\"true\");"
}

### trigger rule
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "ruleTrigger",
  "name": "发送查询请求",
  "sql": "SELECT \"async\" as kind, ts1, ts2, xids FROM triggerStream",
  "actions": [
    {
      "nanoquery": {
        "url": "tcp://127.0.0.1:10000",
        "format": "delimited",
        "delimiter": "-",
        "fields": [
          "kind",
          "ts1",
          "ts2",
          "xids"
        ],
        "sendSingle": true
      }
    }
  ]
}

### 2. 创建长期运行采集流定义，接入nano query 异步结果
POST http://{{host}}/streams
Content-Type: application/json

{
  "sql": "CREATE STREAM queryStream() WITH (TYPE=\"nanoquery\",FORMAT=\"spi\",SCHEMAID=\"dbc\/gee\/gee.json\",SHARED=\"true\",CONF_KEY=\"smooth\");"
}

### 3. 创建单次运行采集规则
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "ruleHistoryQuery1",
  "name": "测试历史数据",
  "sql": "SELECT ts, `PropulsionCAN.0x342.HvCellUOverFlt`,`PropulsionCAN.0x346.HvBattCooltLvl`,`PropulsionCAN.0x142.HvBattCellUInfoU3`,`PropulsionCAN.0x331.HvBattCooltT`,`PropulsionCAN.0x342.HvPackUUnderFlt`,`PropulsionCAN.0x178.HvSysLimnIndcn`,`ZCU_CANFD2.0x1A6.IsgCooltFlowMinReqCloud`,`ZCU_CANFD1.0x353.DCChrgnHndlSts`,`ZCU_CANFD1.0x180.BrkPedlPsdBrkPedlPsd`,`PropulsionCAN.0x145.CellUMinId`,`PropulsionCAN.0x156.IsgUDc`,`PropulsionCAN.0x15E.BECMHvUHvFuseU`,`PropulsionCAN.0x15E.BECMHvUMainPosRlyU`,`PropulsionCAN.0x197.BECMSupplyVoltKL30`,`ConnectivityCANFD.0x3C8.VehSpdAvgIndcdVehSpdIndcd`,`PropulsionCAN.0x342.HvSocLoFlt`,`ZCU_CANFD2.0x482.IsgActvDampgModReq`,`PropulsionCAN.0x145.CellUMin`,`ZCU_CANFD2.0x1A0.FrntHeatPwrAllwd`,`PropulsionCAN.0x342.HvCellTOverFlt`,`PropulsionCAN.0x342.HvCellUDifFlt`,`PropulsionCAN.0x342.HvilFlt`,`PropulsionCAN.0x287.CooltFlowForDtElec`,`ZCU_CANFD2.0x35.IsgIDc`,`ZCU_CANFD2.0x138.BattURaw`,`PropulsionCAN.0x315.HvBattTAvg`,`ZCU_CANFD2.0x491.BattIRaw`,`PropulsionCAN.0x116.AccrPedlPsdAccrPedlPsd`,`PropulsionCAN.0x143.HvBattIDc1`,`PropulsionCAN.0x53.CPSRU`,`PropulsionCAN.0x342.HvSocHiFlt`,`PropulsionCAN.0x342.HvSocHopFlt`,`PropulsionCAN.0x142.HvBattCellUInfoU4`,`ZCU_CANFD2.0x1A0.BattVoltKL30`,`ZCU_CANFD2.0x1A6.IsgCoolgReqInvrCloud`,`PropulsionCAN.0x295.HvBattCoolgSts`,`PropulsionCAN.0x15E.BECMHvUMainNegRlyU`,`PropulsionCAN.0x288.FastChrgnLEDIndctn`,`PropulsionCAN.0x178.HvBattCoolgReq`,`PropulsionCAN.0x13A.IsgCooltT`,`PropulsionCAN.0x315.HvBattTMax`,`ZCU_CANFD2.0x138.IsgInvrT`,`PropulsionCAN.0x342.HvPackUOverFlt`,`PropulsionCAN.0x342.HvCellTDifFlt`,`PropulsionCAN.0x191.FrntHeatModEnad`,`PropulsionCAN.0x145.CellUMax`,`PropulsionCAN.0x141.HvBattUDc`,`PropulsionCAN.0x142.HvBattLimnIndcn`,`PropulsionCAN.0x342.HvPackOverChrgFlt`,`PropulsionCAN.0x342.HvBattMismatchFlt` FROM queryStream",
  "actions": [
    {
      "file": {
        "path": "data/ruleHistoryQuery1.zstd",
        "format": "delimited",
        "fileType": "csv",
        "hasHeader": true,
        "sendSingle": true
      }
    }
  ],
  "options": {
    "sendError": false
  }
}

##### 场景3 历史采集-Sync
### send with start and end
POST http://{{host}}/tables
Content-Type: application/json

{
  "sql": "CREATE TABLE nanoTable() WITH (TYPE=\"nano\",FORMAT=\"spi\",SCHEMAID=\"dbc\/gee\/gee.json\",KIND=\"lookup\",CONF_KEY=\"lookup\");"
}

### send with start and end
POST http://{{host}}/streams
Content-Type: application/json

{
  "sql": "CREATE STREAM triggerStream() WITH (TYPE=\"mqtt\",FORMAT=\"json\",DATASOURCE=\"trigger\",SHARED=\"true\");"
}

### Get all
PUT http://{{host}}/rules/ruleFetch
Content-Type: application/json

{
