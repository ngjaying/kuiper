### batch can json
POST http://{{host}}/streams
Content-Type: application/json

{
  "sql": "CREATE STREAM canDemo() WITH (TYPE=\"mqtt\",FORMAT=\"canjson\",DATASOURCE=\"canudp\",SHARED=\"true\", SCHEMAID=\"dbc\");"
}

### Get all
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "ruleAll",
  "name": "测试所有数据",
  "sql": "SELECT * FROM canDemo",
  "actions": [
    {
      "mqtt": {
        "server": "tcp://syno.home:1883",
        "topic": "result/batch",
        "sendSingle": true
      }
    }
  ]
}

### Get all
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "ruleFetch",
  "name": "采集转弯数据",
  "sql": "SELECT DRIVE.Angle as angle, DRIVE.Speed as speed, DRIVE.Acceleration as acceleration, ENGINE.temperature as engineTemp, ENGINE.RPM as rpm FROM canDemo WHERE DRIVE.Angle > 10",
  "actions": [
    {
      "mqtt": {
        "server": "tcp://syno.home:1883",
        "topic": "result/angle",
        "sendSingle": true
      }
    }
  ]
}

###
GET http://{{host}}/rules/ruleFetch/status

### Send multiple batch data
#{"frames":[{"id":485,"data":"7c00019000000000","bus":4,"d":0,"t":0},{"id":555,"data":"2b020000080000005465737400000000","bus":4,"d":0,"t":0}]}

### single can json with batch can
PUT http://{{host}}/streams/canjson
Content-Type: application/json

{
  "sql": "CREATE STREAM canjson() WITH (TYPE=\"mqtt\",FORMAT=\"json\",DATASOURCE=\"sim2\",SHARED=\"true\", CONF_KEY=\"canjson\");"
}

### Get all
POST http://{{host}}/rules
Content-Type: application/json

{
  "id": "ruleJsonAll",
  "name": "测试所有数据",
  "sql": "SELECT * FROM canjson",
  "actions": [
    {
      "mqtt": {
        "server": "tcp://syno.home:1883",
        "topic": "result/json",
        "sendSingle": true
      }
    }
  ],
  "options": {
    "debug": true
  }
}

### Send data
#{"frames":[{"id":555,"data":"KwIAAAgAAABUZXN0AAAAAA==","bus":4,"d":0,"t":0}]}

### rate limit for can
