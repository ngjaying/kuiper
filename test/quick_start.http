Content-Type: application/json

{
  "sql": "CREATE STREAM batchCan() WITH (TYPE=\"mqtt\",FORMAT=\"can\",DATASOURCE=\"sim3\",SHARED=\"true\", SCHEMAID=\"dbc\/test\",CONF_KEY=\"batch\");"
}

